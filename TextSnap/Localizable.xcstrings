    "settings.permission.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "settings.permission.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First capture asks once in a system dialog. If denied, allow TextSnap here and come back — it works right away. If you turned the switch off and back on, relaunch TextSnap first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次识别会弹一次系统授权窗。若拒绝，在此允许 TextSnap 后回来即刻可用。若曾关闭后重新打开开关，需先重启 TextSnap。"
          }
        }
      }
    },
