    "about.credits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TextSnap: press a shortcut, box a region, text lands in the clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TextSnap：按快捷键框选屏幕，文字直接进入剪贴板。"
