    "settings.hotkey.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Record, then press the new combination. Factory default is ⌘⇧2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点“录制”，再按新组合键。出厂默认 ⌘⇧2。"
          }
        }
      }
    },
    "settings.hotkey.recordingHint": {
      "extractionState": "manual",
      "localizations": {
