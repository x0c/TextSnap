    "permission.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen recording is off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕录制未打开"
          }
        }
      }
    },
    "permission.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TextSnap cannot see the region you select until you allow it under Privacy & Security → Screen & System Audio Recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“隐私与安全性 → 屏幕与系统音频录制”里允许 TextSnap 之前，它看不到你框选的区域。"
          }
        }
      }
    },
    "permission.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "capture.failed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read that region"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能读取这块区域"
          }
        }
      }
    },
    "capture.failed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture or recognition failed. Try again with a larger, sharper region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图或识别失败。换一块更大更清晰的区域再试。"
          }
        }
      }
    },
    "capture.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没找到文字"
          }
        }
      }
    },
    "capture.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing readable in that region. Try a larger region with sharper text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这块区域里没有可读文字。换一块更大、字更清晰的区域。"
          }
        }
      }
    },
    "intent.capture.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Screen Text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别屏幕文字"
          }
        }
      }
    },
    "intent.capture.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture a screen region and copy its text to the clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "框选一块屏幕区域，把其中的文字拷入剪贴板。"
          }
        }
      }
    }
